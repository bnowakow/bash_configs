# Copy this file to ansible/.env and replace the placeholder values.
# Values use shell syntax: quote values containing spaces or shell metacharacters.

RANCHER_BOOTSTRAP_PASSWORD='replace-with-a-strong-temporary-password'
CLOUDFLARE_API_TOKEN='replace-with-a-cloudflare-api-token'
CLOUDCASA_CLUSTER_ID='replace-with-the-cloudcasa-cluster-id'
GITHUB_USERNAME='replace-with-your-github-username'
GITHUB_TOKEN='replace-with-a-github-token-with-repository-read-access'

# Credentials for the third K3s server. These differ from the Proxmox hosts.
NAS_ANSIBLE_USER='sup'
NAS_ANSIBLE_PASSWORD='replace-with-the-nas-ssh-password'
DUCKDNS_TOKEN='replace-with-the-duckdns-token'
