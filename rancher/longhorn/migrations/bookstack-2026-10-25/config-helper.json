{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "bookstack-config-transfer-20261025",
    "namespace": "apps-bookstack"
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "nodeSelector": {
      "kubernetes.io/hostname": "proxmox2-old"
    },
    "containers": [
      {
        "name": "transfer",
        "image": "python:3.13-slim",
        "command": [
          "sleep",
          "7200"
        ],
        "securityContext": {
          "runAsUser": 0,
          "runAsGroup": 0
        },
        "resources": {
          "requests": {
            "cpu": "50m",
            "memory": "64Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "config",
            "mountPath": "/target/config",
            "readOnly": false
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "config",
        "persistentVolumeClaim": {
          "claimName": "bookstack-config-longhorn-rwo",
          "readOnly": false
        }
      }
    ]
  }
}
