{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "ubooquity-longhorn-20261024",
    "namespace": "apps-ubooquity"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 600,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "copy-config",
            "image": "alpine:3.22.1",
            "command": [
              "sh",
              "-ec"
            ],
            "args": [
              "set -eu\ncp -a /source/. /target/\nsync\ncd /source\nfind . -type f -exec sha256sum {} + | sort > /tmp/checksums\nif [ -s /tmp/checksums ]; then\n  cd /target\n  sha256sum -c /tmp/checksums\nelse\n  test -z \"$(find /target -type f -print -quit)\"\n  echo 'Empty source and target verified'\nfi\necho 'Stopped-source copy and checksum verification completed'\n"
            ],
            "volumeMounts": [
              {
                "name": "source-config",
                "mountPath": "/source",
                "readOnly": true
              },
              {
                "name": "target-config",
                "mountPath": "/target"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "source-config",
            "persistentVolumeClaim": {
              "claimName": "ubooquity-config",
              "readOnly": true
            }
          },
          {
            "name": "target-config",
            "persistentVolumeClaim": {
              "claimName": "ubooquity-config-longhorn-rwo"
            }
          }
        ]
      }
    }
  }
}
